# Local development needs no .env file: `npm run dev` connects to the Firebase
# Emulator Suite (`npm run emulators`) with the demo project `demo-jualokal`.
# Copy to `.env` only to override these values.

# Set to "false" to use a real Firebase project in development.
# Set to "true" to force the emulators in a production build (for example CI).
VITE_FIREBASE_USE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Required only when not using the emulators (values from the Firebase console
# web app settings; they are public identifiers, not secrets).
VITE_FIREBASE_PROJECT_ID=demo-jualokal
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Server side, outside the emulators: the Firebase Admin SDK uses Application
# Default Credentials, e.g. GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
